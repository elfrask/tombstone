# src/views.clsx - Páginas del proyecto demo (composición de componentes CMX).
#
# El motor vive en modules/tombstone; acá solo se arma la presentación.
# Los props tipados se convierten a `Record<String, Value>` antes del spread:
# el contrato de CMX exige ese layout para fusionar props en un tag.
from "tombstone" import AnchorProps, ButtonProps;
from "tombstone" import NavBarProps, HeroBannerProps, TerminalPanelProps, SiteFooterProps;
from "tombstone" import ChipProps, UiCardProps;
from "./components" import NavBar, HeroBanner, TerminalPanel, SiteFooter;
from "./components" import Button, Link, Chip, UiCard;

export interface LandingPageProps {
    id: String,
};

export interface GalleryPageProps {
    id: String,
};

const TERM_HTML = "<span class=\"t-m\"># src/main.clsx</span>\n"
    + "<span class=\"t-k\">app.get</span>(<span class=\"t-s\">\"/users/{id}\"</span>, (req: Request) -> Response {\n"
    + "    <span class=\"t-k\">return</span> Response.<span class=\"t-f\">json</span>({ <span class=\"t-s\">\"id\"</span>: req.params[<span class=\"t-s\">\"id\"</span>] });\n"
    + "});\n"
    + "\n"
    + "<span class=\"t-p\">$</span> clx run src/main.clsx -- 8080\n"
    + "<span class=\"t-c\">Servidor en http://localhost:8080</span><span class=\"t-cur\"></span>";

export function Landing(props: Record<String, Value>, children: Cmx[]) -> Cmx {
    var nav: NavBarProps = {
        id: "",
        className: "nav",
        brand: "tombstone",
        badge: "v1.0",
        ctaHref: "#code",
        ctaLabel: "Comenzar"
    };
    var navProps: Record<String, Value> = nav;

    var hero: HeroBannerProps = {
        id: "",
        className: "hero",
        kicker: "100% CLS puro · sin dependencias",
        title: "Tombstone",
        lead: "Framework HTTP en CLS. Rutas, no boilerplate.",
        primaryHref: "#code",
        primaryLabel: "Comenzar",
        secondaryHref: "/api/health",
        secondaryLabel: "API en vivo"
    };
    var heroProps: Record<String, Value> = hero;

    var terminal: TerminalPanelProps = {
        id: "code",
        className: "terminal",
        title: "src/main.clsx",
        code: TERM_HTML
    };
    var terminalProps: Record<String, Value> = terminal;

    var footer: SiteFooterProps = {
        id: "",
        className: "footer",
        brand: "Tombstone"
    };
    var footerProps: Record<String, Value> = footer;

    return (
        <div id={str(props.id)} class="page">
            <NavBar {...navProps} />
            <main class="main">
                <HeroBanner {...heroProps}>
                    <TerminalPanel {...terminalProps} />
                </HeroBanner>
            </main>
            <SiteFooter {...footerProps} />
        </div>
    );
};

export function Gallery(props: Record<String, Value>, children: Cmx[]) -> Cmx {
    var primary: ButtonProps = {
        id: "",
        className: "btn btn--primary",
        type: "button",
        disabled: false
    };
    var primaryProps: Record<String, Value> = primary;

    var secondary: ButtonProps = {
        id: "",
        className: "btn btn--ghost",
        type: "button",
        disabled: true
    };
    var secondaryProps: Record<String, Value> = secondary;

    var docs: AnchorProps = {
        id: "",
        className: "btn btn--ghost",
        href: "#docs",
        target: "_self",
        rel: ""
    };
    var docsProps: Record<String, Value> = docs;

    var chip: ChipProps = {
        id: "",
        className: "",
        value: "",
        label: "CMX",
        icon: "code"
    };
    var chipProps: Record<String, Value> = chip;

    var card: UiCardProps = {
        id: "",
        className: "card",
        title: "Componentes CMX",
        body: "Props tipados con interfaces y spreads."
    };
    var cardProps: Record<String, Value> = card;

    return (
        <main id={str(props.id)} class="main gallery">
            <div class="wrap">
                <h1>UI Kit</h1>
                <p>Componentes como funciones que devuelven Cmx.</p>
                <div class="hero__cta">
                    <Button {...primaryProps}>Comenzar</Button>
                    <Button {...secondaryProps}>Deshabilitado</Button>
                    <Link {...docsProps}>Documentación</Link>
                </div>
                <ul class="chips">
                    <Chip {...chipProps} />
                </ul>
                <UiCard {...cardProps}>
                    <span class="kicker">slot de children</span>
                </UiCard>
            </div>
        </main>
    );
};
