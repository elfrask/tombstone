# src/seeders.clsx - Seeders idempotentes del demo.
from "tombstone" import Database, Factory, Model, Seeder, hash_password;
from "./dtos" import NoteInput;
from "./repositories" import NoteRepository, UserRepository;


class UserFactory: Factory {
    function main(model: Model) { me.model = model; me.sequence = 0; }
    function make(overrides: Record<String, String>) -> Record<String, String> {
        var n = me.sequence;
        me.sequence = me.sequence + 1;
        var r: Record<String, String> = {
            name: "Admin " + n.toString(),
            email: "admin" + n.toString() + "@example.com",
            password_hash: hash_password("secret123")
        };
        var keys: String[] = overrides.keys();
        for each k in (keys) { r[k] = overrides[k]; };
        return r;
    }
};

class NoteFactory: Factory {
    function main(model: Model) { me.model = model; me.sequence = 0; }
    function make(overrides: Record<String, String>) -> Record<String, String> {
        var n = me.sequence;
        me.sequence = me.sequence + 1;
        var r: Record<String, String> = {title: "Nota " + n.toString(), user_id: ""};
        var keys: String[] = overrides.keys();
        for each k in (keys) { r[k] = overrides[k]; };
        return r;
    }
};

export class UserSeeder: Seeder {
    public var users: UserRepository;

    function main(users: UserRepository) { me.users = users; }

    function run(db: Database) -> int {
        if (me.users.find_by_email("admin@example.com").exists) { return 0; };
        UserFactory(me.users.users).create({email: "admin@example.com"});
        return 1;
    }
};

export class NoteSeeder: Seeder {
    public var notes: NoteRepository;
    public var users: UserRepository;

    function main(notes: NoteRepository, users: UserRepository) {
        me.notes = notes;
        me.users = users;
    }

    function run(db: Database) -> int {
        if (me.notes.count() > 0) { return 0; };
        var admin = me.users.find_by_email("admin@example.com");
        var owner = "";
        if (admin.exists) { owner = admin.get("id"); };
        NoteFactory(me.notes.notes).create({title: "Nota de bienvenida", user_id: owner});
        return 1;
    }
};
