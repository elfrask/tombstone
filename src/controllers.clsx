# src/controllers.clsx - Controladores del proyecto demo.
#
# El controller valida y mapea a DTOs; delega en Actions/Repository/Resource.
from "tombstone" import Controller, PaginatedResource, Request, Response;
from "./actions" import CreateNoteAction, DeleteNoteAction, RestoreNoteAction;
from "./dtos" import NoteInput, RegisterUserInput;
from "./repositories" import NoteRepository;
from "./resources" import NoteResource;

export class RegistrationController: Controller {
    function main(req: Request) {
        super.main(req);
    }

    function handle() -> Response {
        if (me.action_name == "store") { return me.store(); };
        return me.error("accion no soportada", 500);
    }


    function store() -> Response {
        var v = me.validate({
            name: "required|string|min:2|max:40",
            email: "required|email",
            password: "required|min:8|confirmed"
        });
        if (v.failed()) {
            return me.invalid(v);
        };
        var input = RegisterUserInput(
            v.data["name"], v.data["email"], v.data["password"]
        );
        var out = input.public_record();
        return me.created({ok: true, name: out["name"], email: out["email"]});
    }
};

export class NotesController: Controller {
    public var notes: NoteRepository;
    public var create_note: CreateNoteAction;
    public var delete_note: DeleteNoteAction;
    public var restore_note: RestoreNoteAction;
    public var note_resource: NoteResource;

    function main(
        req: Request,
        notes: NoteRepository,
        create_note: CreateNoteAction,
        delete_note: DeleteNoteAction,
        restore_note: RestoreNoteAction,
        note_resource: NoteResource
    ) {
        super.main(req);
        me.notes = notes;
        me.create_note = create_note;
        me.delete_note = delete_note;
        me.restore_note = restore_note;
        me.note_resource = note_resource;
    }

    function handle() -> Response {
        if (me.action_name == "index") { return me.index(); };
        if (me.action_name == "trashed") { return me.trashed(); };
        if (me.action_name == "page") { return me.page(); };
        if (me.action_name == "store") { return me.store(); };
        if (me.action_name == "show") { return me.show(); };
        if (me.action_name == "destroy") { return me.destroy(); };
        if (me.action_name == "restore") { return me.restore(); };
        return me.error("accion no soportada", 500);
    }

    function index() -> Response {
        return me.ok({count: me.notes.count()});
    }

    function trashed() -> Response {
        return me.ok({count: me.notes.trashed_count()});
    }

    function page() -> Response {
        var p = me.notes.paginate(1, 10);
        var body = PaginatedResource(me.note_resource, p).to_json();
        return Response.json_response(body);
    }

    function store() -> Response {
        var v = me.validate({title: "required|string|min:1|max:120"});
        if (v.failed()) {
            return me.invalid(v);
        };
        var row = me.create_note.handle(NoteInput(v.data["title"]));
        return me.created(me.note_resource.to_record(row));
    }

    function show() -> Response {
        var row = me.notes.find(me.param("id"));
        if (!row.exists) {
            return me.not_found();
        };
        return me.ok(me.note_resource.to_record(row));
    }

    function destroy() -> Response {
        var id = me.param("id");
        if (!me.notes.find(id).exists) {
            return me.not_found();
        };
        var n = me.delete_note.handle(id);
        if (n == 0) { return me.not_found(); };
        return me.ok({deleted: true, id: id});
    }

    function restore() -> Response {
        var id = me.param("id");
        if (!me.notes.trashed(id)) {
            return me.not_found();
        };
        var n = me.restore_note.handle(id);
        if (n == 0) { return me.not_found(); };
        var row = me.notes.find(id);
        return me.ok({
            restored: true,
            id: row.get("id"),
            title: row.get_str("title")
        });
    }
};
