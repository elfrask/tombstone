# src/controllers.clsx - Controladores del proyecto demo.
#
# El controller valida y mapea a DTOs; delega en Actions/Repository/Resource.
from "tombstone" import AuthGuard, Controller, CookieOptions, PaginatedResource, RateLimiter, Request, Response, serialize_cookie, parse_cookies;
from "./actions" import CreateNoteAction, DeleteNoteAction, RestoreNoteAction;
from "./dtos" import NoteInput, RegisterUserInput;
from "./repositories" import NoteRepository, UserRepository;
from "./resources" import NoteResource;

export class RegistrationController: Controller {
    public var users: UserRepository;

    function main(req: Request, users: UserRepository) {
        super.main(req);
        me.users = users;
    }

    function handle() -> Response {
        if (me.action_name == "store") { return me.store(); };
        return me.error("accion no soportada", 500);
    }

    function store() -> Response {
        var v = me.validate({
            name: "required|string|min:2|max:40",
            email: "required|email",
            password: "required|min:8|confirmed"
        });
        if (v.failed()) {
            return me.invalid(v);
        };
        var input = RegisterUserInput(v.data["name"], v.data["email"], v.data["password"]);
        var row = me.users.create(input.name, input.email, input.password);
        return me.created({ok: true, id: row.get("id"), name: input.name, email: input.email});
    }
};

export class AuthController: Controller {
    public var auth: AuthGuard;
    public var limiter: RateLimiter;

    function main(req: Request, auth: AuthGuard, limiter: RateLimiter) {
        super.main(req);
        me.auth = auth;
        me.limiter = limiter;
    }

    function handle() -> Response {
        if (me.action_name == "login") { return me.login(); };
        if (me.action_name == "me") { return me.current(); };
        if (me.action_name == "logout") { return me.logout(); };
        return me.error("accion no soportada", 500);
    }

    function session_id() -> String {
        var jar = parse_cookies(me.req.header("cookie"));
        if (jar.has("sid")) { return jar["sid"]; };
        return "";
    }

    function login() -> Response {
        var key = me.req.header("x-forwarded-for");
        if (key == "") { key = "local"; };
        if (!me.limiter.allow("login:" + key, 5, 60000)) {
            return me.error("Too many requests", 429);
        };
        var v = me.validate({email: "required|email", password: "required"});
        if (v.failed()) { return me.invalid(v); };
        var s = me.auth.login(v.data["email"], v.data["password"]);
        if (!s.valid()) { return me.error("Credenciales invalidas", 401); };
        var user = me.auth.user(s.id);
        var opts = CookieOptions();
        opts.path = "/";
        opts.http_only = true;
        opts.same_site = "Lax";
        var res = me.ok({id: user.get("id"), name: user.get_str("name"), email: user.get_str("email")});
        res.add_cookie(serialize_cookie("sid", s.id, opts));
        return res;
    }

    function current() -> Response {
        var user = me.auth.user(me.session_id());
        if (!user.exists) { return me.error("No autenticado", 401); };
        return me.ok({id: user.get("id"), name: user.get_str("name"), email: user.get_str("email")});
    }

    function logout() -> Response {
        me.auth.logout(me.session_id());
        var res = me.ok({ok: true});
        res.add_cookie("sid=; Path=/; Max-Age=0; HttpOnly; SameSite=Lax");
        return res;
    }
};

export class NotesController: Controller {
    public var notes: NoteRepository;
    public var create_note: CreateNoteAction;
    public var delete_note: DeleteNoteAction;
    public var restore_note: RestoreNoteAction;
    public var note_resource: NoteResource;

    function main(
        req: Request,
        notes: NoteRepository,
        create_note: CreateNoteAction,
        delete_note: DeleteNoteAction,
        restore_note: RestoreNoteAction,
        note_resource: NoteResource
    ) {
        super.main(req);
        me.notes = notes;
        me.create_note = create_note;
        me.delete_note = delete_note;
        me.restore_note = restore_note;
        me.note_resource = note_resource;
    }

    function handle() -> Response {
        if (me.action_name == "index") { return me.index(); };
        if (me.action_name == "trashed") { return me.trashed(); };
        if (me.action_name == "page") { return me.page(); };
        if (me.action_name == "store") { return me.store(); };
        if (me.action_name == "show") { return me.show(); };
        if (me.action_name == "destroy") { return me.destroy(); };
        if (me.action_name == "restore") { return me.restore(); };
        return me.error("accion no soportada", 500);
    }

    function index() -> Response {
        return me.ok({count: me.notes.count()});
    }

    function trashed() -> Response {
        return me.ok({count: me.notes.trashed_count()});
    }

    function page() -> Response {
        var p = me.notes.paginate(1, 10);
        var body = PaginatedResource(me.note_resource, p).to_json();
        return Response.json_response(body);
    }

    function store() -> Response {
        var v = me.validate({title: "required|string|min:1|max:120"});
        if (v.failed()) {
            return me.invalid(v);
        };
        var row = me.create_note.handle(NoteInput(v.data["title"]));
        return me.created(me.note_resource.to_record(row));
    }

    function show() -> Response {
        var row = me.notes.find(me.param("id"));
        if (!row.exists) {
            return me.not_found();
        };
        return me.ok(me.note_resource.to_record(row));
    }

    function destroy() -> Response {
        var id = me.param("id");
        if (!me.notes.find(id).exists) {
            return me.not_found();
        };
        var n = me.delete_note.handle(id);
        if (n == 0) { return me.not_found(); };
        return me.ok({deleted: true, id: id});
    }

    function restore() -> Response {
        var id = me.param("id");
        if (!me.notes.trashed(id)) {
            return me.not_found();
        };
        var n = me.restore_note.handle(id);
        if (n == 0) { return me.not_found(); };
        var row = me.notes.find(id);
        return me.ok({
            restored: true,
            id: row.get("id"),
            title: row.get_str("title")
        });
    }
};
