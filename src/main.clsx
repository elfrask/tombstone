# src/main.clsx - Proyecto de demostración de Tombstone (el motor vive en
# modules/tombstone).
#
#   clx run src/main.clsx -- 8080        (desde la raíz del repo CLS)
#   clx run src/main.clsx -- 8080 test   (autotest en memoria, sin sockets)
#
# Rutas:
#   GET  /                 landing (Template + componentes CMX + iconos)
#   GET  /ui               galería de componentes con props tipados
#   GET  /api/health       JSON
#   GET  /api/users        JSON (lista)
#   GET  /users/{id}       JSON con params de ruta
#   POST /api/echo         JSON con el body recibido
#   GET  /cookies          cookies recibidas
#   GET  /set-cookie       Set-Cookie + redirect
#   POST /api/register     formulario/JSON validado (Controller)
#   GET  /api/notes        conteo (Model SQLite, sin soft-deleted)
#   POST /api/notes        crea una nota desde un formulario (Model + validaci�n)
#   GET  /api/notes/trashed notas en la papelera
#   DELETE /api/notes/{id} soft delete
#   POST /api/notes/{id}/restore restaura una nota
#   GET  /api/notes/{id}   nota por id (Model)
#   GET  /public/*         archivos estáticos (fs del nodo)
import "sqlite" as sqlite;
from "tombstone" import App, Request, Response, CorsOptions, CookieOptions, Template;
from "tombstone" import render, json_response, json_response_raw, json_string_array;
from "tombstone" import parse_cookies, serialize_cookie, system_pid, system_uptime_ms;
from "tombstone" import Database, MigrationRunner, serve;
from "./controllers" import RegistrationController, NotesController;
from "./migrations" import CreateInitialSchema;
from "./views" import Landing, LandingPageProps, Gallery, GalleryPageProps;

# Los shims de `fs` y `socket` se resuelven relativos al CWD: este demo se
# ejecuta desde la raíz del repo CLS.
const PUBLIC_DIR = "cls-repositories/tombstone/public";

# Resumen de una respuesta para el autotest (no imprime el body completo).
function summary(label: String, res: Response) -> String {
    return label + " -> " + res.status.toString() + " (" + res.body.length.toString() + " B)";
};

# Template base: idioma, assets, fuentes y meta comunes a todo el sitio.
function base_template() -> Template {
    var t = Template();
    t.set_lang("es");
    t.set_charset("utf-8");
    t.set_viewport("width=device-width, initial-scale=1");
    t.add_meta("color-scheme", "dark");
    t.add_meta("theme-color", "#0b1020");
    t.add_style("/public/css/style.css");
    t.add_script("/public/js/app.js");
    t.set_favicon("/public/favicon.svg");
    t.set_head("<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap\">");
    return t;
};

# Cada página hereda los parámetros del base y solo sobrescribe lo suyo.
function page_template(title: String, description: String) -> Template {
    var t = Template.derive(base_template());
    t.set_title(title);
    t.set_description(description);
    t.set_author("Tombstone");
    return t;
};

function main(args: String[]) -> int {
    var port = 8080;
    if (args.length > 0) {
        port = int(args[0]);
    };

    print("=== Tombstone ===");
    print("pid:", system_pid(), "uptime_ms:", system_uptime_ms());

    var db = Database(sqlite::SqliteDriver());
    db.connect(":memory:");
    MigrationRunner(db.orm).add(CreateInitialSchema()).run();
    var notes = db.table("notes").timestamps().soft_deletes();

    var app = App();
    app.cors(CorsOptions());
    app.use("logging", (req: Request) -> Response {
        print("-> " + req.http_method + " " + req.path);
        return Response.status_only(0);
    });
    app.serve_static("/public", PUBLIC_DIR);

    # Landing: componentes CMX (NavBar/HeroBanner/TerminalPanel/SiteFooter).
    app.get("/", (req: Request) -> Response {
        var landing: LandingPageProps = { id: "top" };
        var landingProps: Record<String, Value> = landing;
        var t = page_template("Tombstone — framework HTTP en CLS puro", "Framework HTTP para CLS: sockets, router, middleware, CORS, cookies y vistas CMX.");
        t.set_body_class("landing");
        t.add_meta_prop("property", "og:title", "Tombstone");
        t.add_meta_prop("property", "og:description", "Framework HTTP para CLS. Sockets, router, middleware, CORS y vistas CMX.");
        t.add_meta_prop("property", "og:type", "website");
        return Response.html(render(t.render((<Landing {...landingProps} />))));
    });

    # Galería de componentes con props tipados por interfaces.
    app.get("/ui", (req: Request) -> Response {
        var gallery: GalleryPageProps = { id: "gallery" };
        var galleryProps: Record<String, Value> = gallery;
        var t = page_template("UI Kit — Tombstone", "Componentes CMX con props tipados.");
        t.set_body_class("landing");
        return Response.html(render(t.render((<Gallery {...galleryProps} />))));
    });

    app.get("/api/health", (req: Request) -> Response {
        return json_response({status: "ok", server: "tombstone", version: "1.0"});
    });

    app.get("/api/users", (req: Request) -> Response {
        var users = ["ana", "beto", "carla"];
        return json_response_raw("{\"ok\":true,\"users\":" + json_string_array(users) + "}");
    });

    app.get("/users/{id}", (req: Request) -> Response {
        return json_response({id: req.param("id"), activo: true});
    });

    app.post("/api/echo", (req: Request) -> Response {
        return json_response({recibido: req.body, content_type: req.header("content-type")});
    });

    # Formulario o JSON; Request.validate + Controller.
    app.post("/api/register", (req: Request) -> Response {
        return RegistrationController(req).store();
    });

    # Model sobre SQLite en memoria.
    app.get("/api/notes", (req: Request) -> Response {
        return NotesController(req, notes).index();
    });

    app.post("/api/notes", (req: Request) -> Response {
        return NotesController(req, notes).store();
    });

    app.get("/api/notes/trashed", (req: Request) -> Response {
        return NotesController(req, notes).trashed();
    });

    app.delete_route("/api/notes/{id}", (req: Request) -> Response {
        return NotesController(req, notes).destroy();
    });

    app.post("/api/notes/{id}/restore", (req: Request) -> Response {
        return NotesController(req, notes).restore();
    });

    app.get("/api/notes/{id}", (req: Request) -> Response {
        return NotesController(req, notes).show();
    });

    app.get("/cookies", (req: Request) -> Response {
        var jar = parse_cookies(req.header("cookie"));
        var out = "cookies:";
        for each key in (jar.keys()) {
            out = out + " " + key + "=" + jar[key] + ";";
        };
        return Response.text(out);
    });

    app.get("/set-cookie", (req: Request) -> Response {
        var opts = CookieOptions();
        opts.path = "/";
        opts.http_only = true;
        var res = Response.redirect("/cookies", 302);
        res.headers["set-cookie"] = serialize_cookie("visita", "1", opts);
        return res;
    });

    # Modo autotest: procesa requests en memoria (sin sockets).
    if (args.length > 1 && args[1] == "test") {
        print("--- autotest ---");
        print(summary("GET /api/health", app.handle("GET /api/health HTTP/1.1\r\nHost: x\r\n\r\n")));
        print(summary("GET /", app.handle("GET / HTTP/1.1\r\nHost: x\r\n\r\n")));
        print(summary("GET /ui", app.handle("GET /ui HTTP/1.1\r\nHost: x\r\n\r\n")));
        print(summary("GET /users/42", app.handle("GET /users/42 HTTP/1.1\r\nHost: x\r\n\r\n")));
        print(summary("GET /nope", app.handle("GET /nope HTTP/1.1\r\nHost: x\r\n\r\n")));

        var regBody = "name=Ana&email=ana%40example.com&password=secret123&password_confirmation=secret123";
        var regRaw = "POST /api/register HTTP/1.1\r\nHost: x\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: " + regBody.length.toString() + "\r\n\r\n" + regBody;
        print(summary("POST /api/register", app.handle(regRaw)));

        var badBody = "name=A&email=no&password=1";
        var badRaw = "POST /api/register HTTP/1.1\r\nHost: x\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: " + badBody.length.toString() + "\r\n\r\n" + badBody;
        print(summary("POST /api/register invalid", app.handle(badRaw)));

        var noteBody = "title=Hola";
        var noteRaw = "POST /api/notes HTTP/1.1\r\nHost: x\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: " + noteBody.length.toString() + "\r\n\r\n" + noteBody;
        print(summary("POST /api/notes", app.handle(noteRaw)));
        print(summary("GET /api/notes/1", app.handle("GET /api/notes/1 HTTP/1.1\r\nHost: x\r\n\r\n")));
        print(summary("GET /api/notes", app.handle("GET /api/notes HTTP/1.1\r\nHost: x\r\n\r\n")));
        print(summary("DELETE /api/notes/1", app.handle("DELETE /api/notes/1 HTTP/1.1\r\nHost: x\r\n\r\n")));
        print(summary("GET /api/notes/trashed", app.handle("GET /api/notes/trashed HTTP/1.1\r\nHost: x\r\n\r\n")));
        print(summary("POST /api/notes/1/restore", app.handle("POST /api/notes/1/restore HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n")));
        print("--- fin autotest ---");
        return 0;
    };

    return serve(app, port);
};
