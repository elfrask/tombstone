# src/repositories.clsx - Repositorio de notas sobre Model (capa de dominio).
from "tombstone" import Model, ModelRow, Paginator, hash_password;
from "./dtos" import NoteInput;

export class UserRepository {
    public var users: Model;
    function main(users: Model) { me.users = users; }
    function find_by_email(email: String) -> ModelRow { return me.users.first_where("email", email); }
    function create(name: String, email: String, password: String) -> ModelRow {
        return me.users.create({name: name, email: email, password_hash: hash_password(password)});
    }
};

export class NoteRepository {
    public var notes: Model;

    function main(notes: Model) {
        me.notes = notes;
    }

    function find(id: String) -> ModelRow { return me.notes.find(id); }
    function count() -> int { return me.notes.count(); }
    function trashed_count() -> int { return me.notes.only_trashed().count(); }
    function trashed(id: String) -> bool { return me.notes.trashed(id); }

    function create(input: NoteInput) -> ModelRow {
        return me.notes.create(input.to_record());
    }

    function paginate(page: int, per_page: int) -> Paginator {
        return me.notes.paginate(page, per_page);
    }

    function delete(id: String) -> int { return me.notes.delete(id); }
    function restore(id: String) -> int { return me.notes.restore(id); }
};
