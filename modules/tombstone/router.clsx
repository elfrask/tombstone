# tombstone/router.clsx - Router con parámetros de ruta y middleware por ruta.
from "httpd" import Request, Response;
from "./middleware" import Middleware;

export class RouteMatch {
    public var matched: bool;
    public var params: Record<String, String>;

    function main(matched: bool, params: Record<String, String>) {
        me.matched = matched;
        me.params = params;
    }
}

export class Route {
    public var http_method: String;
    public var pattern: String;
    public var handler: (Request) -> Response;
    public var middlewares: Middleware[];

    function main(http_method: String, pattern: String, handler: (Request) -> Response) {
        me.http_method = http_method;
        me.pattern = pattern;
        me.handler = handler;
        me.middlewares = [];
    }
}

export function route_matches(pattern: String, route_path: String) -> RouteMatch {
    var params: Record<String, String> = {};
    var pp = pattern.split("/");
    var sp = route_path.split("/");
    if (pp.length != sp.length) {
        return RouteMatch(false, params);
    }

    for each seg and i in (pp) {
        if (seg.length > 2 && seg[0] == "{" && seg[seg.length - 1] == "}") {
            var name = seg.slice(1, seg.length - 1);
            params[name] = sp[i];
        } elif (seg != sp[i]) {
            return RouteMatch(false, params);
        };
    }
    return RouteMatch(true, params);
}

export class Router {
    public var routes: Route[];

    function main() {
        me.routes = [];
    }

    function add(http_method: String, pattern: String, handler: (Request) -> Response) {
        me.routes.push(Route(http_method, pattern, handler));
    }

    function add_with_middleware(
        http_method: String, pattern: String,
        handler: (Request) -> Response, middlewares: Middleware[]
    ) {
        var r = Route(http_method, pattern, handler);
        r.middlewares = middlewares;
        me.routes.push(r);
    }

    function get(pattern: String, handler: (Request) -> Response) { me.add("GET", pattern, handler); }
    function post(pattern: String, handler: (Request) -> Response) { me.add("POST", pattern, handler); }
    function put(pattern: String, handler: (Request) -> Response) { me.add("PUT", pattern, handler); }
    function patch(pattern: String, handler: (Request) -> Response) { me.add("PATCH", pattern, handler); }
    function delete_route(pattern: String, handler: (Request) -> Response) { me.add("DELETE", pattern, handler); }
    function options(pattern: String, handler: (Request) -> Response) { me.add("OPTIONS", pattern, handler); }

    function dispatch(req: Request) -> Response {
        var path_exists = false;
        for each r in (me.routes) {
            var m = route_matches(r.pattern, req.path);
            if (m.matched) {
                path_exists = true;
                if (r.http_method == req.http_method) {
                    req.params = m.params;
                    for each mw in (r.middlewares) {
                        var mres = mw.run(req);
                        if (mres.status != 0) { return mres; };
                    };
                    var h = r.handler;
                    return h(req);
                };
            };
        };

        if (path_exists) {
            return Response.status_only(405);
        };
        return Response.not_found();
    }
};
