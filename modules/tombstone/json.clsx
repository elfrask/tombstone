# tombstone/json.clsx - Utilidades JSON (envuelve el módulo core `json`).
#
# Nota de deuda: `json` es un módulo interno del nodo (host-side). Se mantiene
# aquí para la API del framework; la migración a un `modules/json` CLS puro
# queda pendiente.
import "json" as json;

from "httpd" import Request, Response;

export function json_encode(value: JSON) -> String {
    return json.stringify(value);
}

export function json_decode(text: String) -> JSON {
    return json.parse(text);
}

export function json_parse_safe(text: String) -> JSON {
    if (text.length == 0) {
        return {};
    };
    try {
        return json.parse(text);
    } catch (err) {
        return {};
    };
}

# Body JSON del request (parseo tolerante; JSON vacío si no parsea).
export function json_body(req: Request) -> JSON {
    return json_parse_safe(req.body);
}

export function json_response(value: JSON) -> Response {
    return Response.json_response(json.stringify(value));
}

export function json_response_raw(content: String) -> Response {
    return Response.json_response(content);
}

# `json.stringify(array)` no es fiable en el JIT actual: este helper serializa
# un array de strings a JSON.
export function json_string_array(items: String[]) -> String {
    var out = "[";
    for each item and i in (items) {
        if (i > 0) {
            out = out + ",";
        };
        out = out + "\"" + item + "\"";
    };
    return out + "]";
}
