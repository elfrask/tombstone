import "fs" as fs;
from "./generator" import make_controller, make_model, make_migration, make_factory, make_action, make_resource;

function usage() {
    print("Uso: tombstone <comando>");
    print("  create app [--force]");
    print("  make:controller <Nombre>");
    print("  make:model <Nombre>");
    print("  make:migration <nombre>");
    print("  make:factory <Nombre>");
    print("  make:action <Nombre>");
    print("  make:resource <Nombre>");
};

function make_command(cmd: String, args: String[]) -> int {
    if (args.length < 2) {
        print("Falta el nombre: " + cmd + " <Nombre>");
        return 1;
    };
    var name = args[1];
    var force = false;
    for each a in (args) {
        if (a == "--force" || a == "-f") { force = true; };
    };
    if (cmd == "make:controller") { return make_controller(name, force); };
    if (cmd == "make:model") { return make_model(name, force); };
    if (cmd == "make:migration") { return make_migration(name, force); };
    if (cmd == "make:factory") { return make_factory(name, force); };
    if (cmd == "make:action") { return make_action(name, force); };
    if (cmd == "make:resource") { return make_resource(name, force); };
    print("Comando desconocido: " + cmd);
    return 1;
};

function create_app(args: String[]) -> int {
    var force = false;
    for each a in (args) {
        if (a == "--force" || a == "-f") { force = true; };
    };
    if (fs.exists("cls.json") && !force) {
        print("tombstone: ya existe cls.json (usa --force para sobrescribir)");
        return 1;
    };
    var dirs: String[] = [
        "app/routes", "app/resources", "app/components", "app/views",
        "app/controllers", "app/requests", "app/core", "app/services", "app/models",
        "database/migrations", "database/database", "database/seeds",
        "config", "public", "tests/unit"
    ];
    for each d in (dirs) { fs.mkdir(d); };
    fs.writeFile("cls.json",
        "{\n" +
        "  \"name\": \"tombstone-app\",\n" +
        "  \"version\": \"0.1.0\",\n" +
        "  \"entry\": \"app/main.clsx\",\n" +
        "  \"dependencies\": {\"tombstone\": \"^0.2.0\"}\n" +
        "}\n");
    fs.writeFile("app/main.clsx",
        "from \"tombstone\" import App, TestClient, serve;\n" +
        "from \"./routes/index\" import register_routes;\n\n" +
        "function main(args: String[]) -> int {\n" +
        "    var app = App();\n" +
        "    register_routes(app);\n" +
        "    if (args.length > 0 && args[0] == \"test\") {\n" +
        "        var client = TestClient(app);\n" +
        "        client.get(\"/\").assert_status(200);\n" +
        "        client.get(\"/no-existe\").assert_status(404).assert_contains(\"Pagina no encontrada\");\n" +
        "        print(\"OK: app\");\n" +
        "        return 0;\n" +
        "    };\n" +
        "    var port = 3000;\n" +
        "    if (args.length > 0) { port = int(args[0]); };\n" +
        "    return serve(app, port);\n" +
        "};\n");
    fs.writeFile("app/routes/index.clsx",
        "from \"tombstone\" import App, Request, Response, render;\n" +
        "from \"./controllers/HomeController\" import HomeController;\n" +
        "from \"./views/Layout\" import Page;\n" +
        "from \"./views/NotFoundView\" import NotFoundView;\n\n" +
        "export function register_routes(app: App) -> App {\n" +
        "    app.get(\"/\", (req: Request) -> Response {\n" +
        "        return HomeController(req).index();\n" +
        "    });\n" +
        "    app.get(\"/health\", (req: Request) -> Response {\n" +
        "        return Response.json_response(\"{\\\"ok\\\":true}\");\n" +
        "    });\n" +
        "    app.not_found((req: Request) -> Response {\n" +
        "        var res = Response(404, render(Page(\"404\", NotFoundView())));\n" +
        "        res.headers[\"content-type\"] = \"text/html; charset=utf-8\";\n" +
        "        return res;\n" +
        "    });\n" +
        "    return app;\n" +
        "};\n");
    fs.writeFile("app/controllers/HomeController.clsx",
        "from \"tombstone\" import Controller, Response, render;\n" +
        "from \"./views/Layout\" import Page;\n" +
        "from \"./views/HomeView\" import HomeView;\n\n" +
        "export class HomeController: Controller {\n" +
        "    function index() -> Response {\n" +
        "        return Response.html(render(Page(\"Inicio\", HomeView())));\n" +
        "    }\n" +
        "};\n");
    fs.writeFile("app/views/HomeView.clsx",
        "from \"./components/Welcome\" import Welcome;\n\n" +
        "export function HomeView() -> Cmx {\n" +
        "    return (<main class=\"container\"><Welcome title=\"Tombstone\" /><p>Tu aplicacion base esta lista.</p></main>);\n" +
        "};\n");
    fs.writeFile("app/views/Layout.clsx",
        "from \"tombstone\" import Template;\n\n" +
        "export function Page(title: String, body: Cmx) -> Cmx {\n" +
        "    var t = Template();\n" +
        "    t.set_lang(\"es\");\n" +
        "    t.set_title(title);\n" +
        "    t.add_style(\"/public/style.css\");\n" +
        "    return t.render(body);\n" +
        "};\n");
    fs.writeFile("app/views/NotFoundView.clsx",
        "export function NotFoundView() -> Cmx {\n" +
        "    return (<main class=\"container not-found\"><p class=\"kicker\">404</p><h1>Pagina no encontrada</h1><a href=\"/\">Volver al inicio</a></main>);\n" +
        "};\n");
    fs.writeFile("app/components/Welcome.clsx",
        "from \"tombstone\" import raw, renderChildren;\n\n" +
        "export function Welcome(props: Record<String, Value>, children: Cmx[]) -> Cmx {\n" +
        "    return (<section class=\"welcome\"><h1>{str(props.title)}</h1>{raw(renderChildren(children))}</section>);\n" +
        "};\n");
    fs.writeFile("config/environment.clsx",
        "import \"env\" as env;\n" +
        "export function load_env() -> env::Env { return env::load(\".env\"); };\n");
    fs.writeFile("config/app.clsx",
        "from \"./environment\" import load_env;\n" +
        "export class AppConfig { public var name: String; public var environment: String; };\n" +
        "export function load_config() -> AppConfig {\n" +
        "    var e = load_env(); var c = AppConfig();\n" +
        "    c.name = \"Tombstone App\"; c.environment = \"development\";\n" +
        "    if (e.get(\"APP_NAME\") != \"\") { c.name = e.get(\"APP_NAME\"); };\n" +
        "    if (e.get(\"APP_ENV\") != \"\") { c.environment = e.get(\"APP_ENV\"); };\n" +
        "    return c;\n" +
        "};\n");
    fs.writeFile(".env.example", "APP_NAME=Tombstone App\nAPP_ENV=development\nDB_PATH=:memory:\n");
    fs.writeFile(".gitignore", "dist/\nmodules/\n.cls-cache/\n.env\n*.db\n");
    fs.writeFile("README.md",
        "# Tombstone app\n\n" +
        "```bash\n" +
        "cp .env.example .env\n" +
        "tombstone make:controller Home\n" +
        "clx run app/main.clsx -- 3000\n" +
        "```\n");
    print("created: Tombstone app");
    return 0;
};

function main(args: String[]) -> int {
    if (args.length == 0) { usage(); return 1; };
    var cmd = args[0];
    if (cmd == "create") {
        if (args.length < 2 || args[1] != "app") {
            print("Uso: tombstone create app [--force]");
            return 1;
        };
        return create_app(args);
    };
    if (cmd.startsWith("make:")) { return make_command(cmd, args); };
    print("Comando desconocido: " + cmd);
    usage();
    return 1;
};
