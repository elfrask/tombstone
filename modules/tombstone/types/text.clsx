# types/text.clsx - Texto, encabezados y enlaces.

from "./types/global" import ElementProps;

export interface HeadingProps extends ElementProps {
};

export interface H1Props extends HeadingProps {
};
export interface H2Props extends HeadingProps {
};
export interface H3Props extends HeadingProps {
};
export interface H4Props extends HeadingProps {
};
export interface H5Props extends HeadingProps {
};
export interface H6Props extends HeadingProps {
};

export interface ParagraphProps extends ElementProps {
};

# Alias corto usado por la etiqueta <p>.
export interface PProps extends ParagraphProps {
};

export interface AnchorProps extends ElementProps {
    href: String,
    target: String,
    rel: String,
};

# Atributos adicionales de <a> (extensión opcional).
export interface AnchorExtraAttrs {
    download: String,
    hrefLang: String,
    type: String,
    referrerPolicy: String,
    ping: String,
};

export interface AnchorFullProps extends AnchorProps, AnchorExtraAttrs {
};

export interface BlockquoteProps extends ElementProps {
    cite: String,
};

