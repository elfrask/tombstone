from "tombstone" import Router, RouteGroup, Request, Response, route_matches;
import "check" as check;

function main(args: String[]) -> int {
    check::reset();

    var m = route_matches("/users/{id}", "/users/42");
    check::assertTrue("match.matched", m.matched);
    check::assertEqStr("match.id", m.params["id"], "42");

    var no = route_matches("/users/{id}", "/posts/42");
    check::assertTrue("match.no", !no.matched);

    var r = Router();
    r.get("/", (req: Request) -> Response {
        return Response.text("home");
    });
    r.get("/users/{id}", (req: Request) -> Response {
        return Response.text("id=" + req.param("id"));
    });

    var home = r.dispatch(Request.parse("GET / HTTP/1.1\r\nHost: x\r\n\r\n"));
    check::assertEq("router.home.status", home.status, 200);
    check::assertEqStr("router.home.body", home.body, "home");

    var user = r.dispatch(Request.parse("GET /users/7 HTTP/1.1\r\nHost: x\r\n\r\n"));
    check::assertEq("router.user.status", user.status, 200);
    check::assertEqStr("router.user.body", user.body, "id=7");

    var wrong = r.dispatch(Request.parse("POST /users/7 HTTP/1.1\r\nHost: x\r\n\r\n"));
    check::assertEq("router.405", wrong.status, 405);

    var missing = r.dispatch(Request.parse("GET /nope HTTP/1.1\r\nHost: x\r\n\r\n"));
    check::assertEq("router.404", missing.status, 404);

    var groupedRouter = Router();
    var api = RouteGroup(groupedRouter, "/api", []);
    api.use("guard", (req: Request) -> Response {
        if (req.header("x-block") == "1") { return Response.status_only(403); };
        return Response.status_only(0);
    });
    api.get("/ping", (req: Request) -> Response { return Response.text("pong"); });
    var grouped = groupedRouter.dispatch(Request.parse("GET /api/ping HTTP/1.1\r\nHost: x\r\n\r\n"));
    check::assertEq("router.group.status", grouped.status, 200);
    check::assertEqStr("router.group.body", grouped.body, "pong");
    var blocked = groupedRouter.dispatch(Request.parse("GET /api/ping HTTP/1.1\r\nHost: x\r\nx-block: 1\r\n\r\n"));
    check::assertEq("router.group.middleware", blocked.status, 403);

    var named = Router();
    named.add_named("GET", "/users/{id}", "user.show", (req: Request) -> Response {
        return Response.text("named");
    });
    check::assertEqStr("router.named.url", named.url("user.show", {id: "7"}), "/users/7");
    named.get("/optional/{id?}", (req: Request) -> Response {
        return Response.text("opt=" + req.param("id"));
    });
    var opt1 = named.dispatch(Request.parse("GET /optional HTTP/1.1\r\nHost: x\r\n\r\n"));
    var opt2 = named.dispatch(Request.parse("GET /optional/9 HTTP/1.1\r\nHost: x\r\n\r\n"));
    check::assertEqStr("router.optional.empty", opt1.body, "opt=");
    check::assertEqStr("router.optional.id", opt2.body, "opt=9");

    if (check::fails() > 0) {
        return 1;
    };
    return 0;
}
