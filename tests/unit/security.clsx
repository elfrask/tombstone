from "tombstone" import Csrf, RateLimiter, RateLimitMiddleware, Request, Session, SessionStore, hash_password, password_needs_rehash, verify_password;
import "check" as check;

function main(args: String[]) -> int {
    check::reset();

    var h = hash_password("secret123");
    check::assertTrue("security.hash.format", h.startsWith("$" + "argon2id" + "$"));
    check::assertTrue("security.hash.verify", verify_password("secret123", h));
    check::assertTrue("security.hash.reject", !verify_password("bad", h));
    check::assertTrue("security.hash.current", !password_needs_rehash(h));
    var legacy = "sha256" + "$" + "1000" + "$" + "a805b8c48f4f90c17927a39db2aada47" + "$" + "0a875bea0bda92a1d4d35b976b73b27b2d9cf84dfb8b40a99480489c5fe4283d";
    check::assertTrue("security.hash.legacy", verify_password("secret123", legacy));
    check::assertTrue("security.hash.legacy.rehash", password_needs_rehash(legacy));

    var store = SessionStore();
    var s = store.create();
    check::assertTrue("security.session.valid", s.valid());
    check::assertEqStr("security.session.find", store.find(s.id).id, s.id);
    check::assertEq("security.session.destroy", store.destroy(s.id), 1);
    check::assertEq("security.session.count", store.count(), 0);
    var exp = store.create();
    exp.expires_at = now() - 1;
    check::assertTrue("security.session.expired", !store.find(exp.id).valid());

    var session = Session("x");
    var csrf = Csrf();
    var token = csrf.token(session);
    check::assertEq("security.csrf.length", token.length, 32);
    check::assertTrue("security.csrf.verify", csrf.verify(session, token));
    check::assertTrue("security.csrf.reject", !csrf.verify(session, "bad"));

    var limiter = RateLimiter();
    check::assertTrue("security.rate.1", limiter.allow("ip", 2, 60000));
    check::assertTrue("security.rate.2", limiter.allow("ip", 2, 60000));
    check::assertTrue("security.rate.3", !limiter.allow("ip", 2, 60000));

    var raw = "GET / HTTP/1.1\r\nHost: x\r\n\r\n";
    var mw = RateLimitMiddleware(RateLimiter(), 2, 60000);
    check::assertEq("security.http.rate.1", mw.check(Request.parse(raw)).status, 0);
    check::assertEq("security.http.rate.2", mw.check(Request.parse(raw)).status, 0);
    var denied = mw.check(Request.parse(raw));
    check::assertEq("security.http.rate.3", denied.status, 429);
    check::assertEqStr("security.http.rate.retry", denied.headers["retry-after"], "60");

    if (check::fails() > 0) { return 1; };
    return 0;
};